{
  "Punto de entrada (main int)": {
    "prefix": "main",
    "body": [
      "weave main into int:",
      "    $0",
      "    return 0"
    ],
    "description": "Punto de entrada `main` con retorno int"
  },
  "Punto de entrada (main void)": {
    "prefix": "mainv",
    "body": [
      "weave main into void:",
      "    $0"
    ],
    "description": "Punto de entrada `main` sin retorno (void)"
  },
  "Función (weave)": {
    "prefix": "weave",
    "body": [
      "weave ${1:nombre} with ${2:param} as ${3:int} into ${4:void}:",
      "    $0"
    ],
    "description": "Declaración de función con parámetros y tipo de retorno"
  },
  "Función sin parámetros": {
    "prefix": "weaveno",
    "body": [
      "weave ${1:nombre} into ${2:void}:",
      "    $0"
    ],
    "description": "Declaración de función sin parámetros"
  },
  "Función inline": {
    "prefix": "weavein",
    "body": [
      "weave inline ${1:nombre} with ${2:param} as ${3:int} into ${4:int}:",
      "    $0"
    ],
    "description": "Función con modificador `inline` (always_inline en C)"
  },
  "Función inline (orden alternativo)": {
    "prefix": "inlineweave",
    "body": [
      "inline weave ${1:nombre} with ${2:param} as ${3:int} into ${4:int}:",
      "    $0"
    ],
    "description": "Función con `inline` antepuesto a `weave`"
  },
  "Método ritual (estático)": {
    "prefix": "weaverit",
    "body": [
      "weave ritual ${1:new} with ${2:nombre} as string into ${3:Tipo}:",
      "    return with ${4:campo} is ${2:nombre}"
    ],
    "description": "Método ritual estático (constructor `new`, `from_*`, `with_*`)"
  },
  "Función genérica (shard)": {
    "prefix": "weaveshard",
    "body": [
      "weave ${1:nombre} shard ${2:T} with ${3:x} as ${2:T} into ${4:T}:",
      "    $0"
    ],
    "description": "Función genérica con un parámetro `shard`"
  },
  "Función genérica con bounds (where)": {
    "prefix": "weaveshardwhere",
    "body": [
      "weave ${1:nombre} shard ${2:T} where ${2:T}: ${3:Num} with ${4:xs} as list of ${2:T} into ${5:T}:",
      "    $0"
    ],
    "description": "Función genérica con bounds `where T: Concept`"
  },
  "Función genérica con dos shards": {
    "prefix": "weaveshard2",
    "body": [
      "weave ${1:nombre} shard ${2:T} and ${3:U} with ${4:a} as ${2:T}, ${5:b} as ${3:U} into ${6:T}:",
      "    $0"
    ],
    "description": "Función genérica con dos parámetros de tipo"
  },
  "Función variádica (many T)": {
    "prefix": "weavemany",
    "body": [
      "weave ${1:contar} with ${2:xs} as many ${3:int} into int:",
      "    return (${2:xs} length to int)"
    ],
    "description": "Función variádica segura respaldada por slice (`many T`)"
  },
  "Declaración externa de C (declare)": {
    "prefix": "declare",
    "body": [
      "declare ${1:c_func} with ${2:param} as ${3:ref to char} into ${4:int}"
    ],
    "description": "Prototipo de función externa de C (sin cuerpo y sin `:`)"
  },
  "Declaración variádica de C (...)": {
    "prefix": "declarevar",
    "body": [
      "declare ${1:printf} with ${2:fmt} as ref to frozen char, ... into ${3:int}"
    ],
    "description": "Prototipo de C con argumentos variádicos crudos (`...`, solo en `declare`)"
  },
  "Lambda": {
    "prefix": "lambda",
    "body": [
      "lambda ${1:x} as ${2:int} into ${3:x * 2}"
    ],
    "description": "Función anónima con parámetros tipados"
  },
  "Lambda sin parámetros": {
    "prefix": "lambdano",
    "body": [
      "lambda into ${1:42}"
    ],
    "description": "Función anónima sin parámetros"
  },
  "Bloque C embebido (antiquus)": {
    "prefix": "antiquus",
    "body": [
      "antiquus ${1:nombre} with ${2:x} as ${3:int} into ${4:int}:",
      "    r\"\"\"",
      "return ${2:x} < 0 ? -${2:x} : ${2:x};",
      "\"\"\""
    ],
    "description": "Función con cuerpo C literal (el C va a columna 0)"
  },
  "Bloque C embebido exportado (@export)": {
    "prefix": "antiquusexport",
    "body": [
      "@export(\"pengu_${1:modulo}_${2:nombre}\")",
      "antiquus ${3:nombre} with ${4:x} as ${5:int} into ${6:int}:",
      "    r\"\"\"",
      "return ${4:x};",
      "\"\"\""
    ],
    "description": "`antiquus` con símbolo C estable, raíz del DCE"
  },
  "Estructura (rune)": {
    "prefix": "rune",
    "body": [
      "rune ${1:Nombre}:",
      "    ${2:campo} as ${3:string}",
      "    $0"
    ],
    "description": "Definición de estructura (rune / struct de C)"
  },
  "Estructura genérica (rune shard)": {
    "prefix": "runeshard",
    "body": [
      "rune ${1:Box} shard ${2:T}:",
      "    ${3:value} as ${4:T}",
      "    $0"
    ],
    "description": "Estructura genérica con parámetro `shard`"
  },
  "Estructura con derive": {
    "prefix": "runederive",
    "body": [
      "rune ${1:Point} derive ${2:Par, Ordo, Vinculum, Imago, Nexus}:",
      "    ${3:x} as ${4:int}",
      "    ${5:y} as ${6:int}"
    ],
    "description": "`rune` con implementaciones automáticas de concepts"
  },
  "Estructura autorreferencial (cyclus)": {
    "prefix": "runecyclus",
    "body": [
      "rune ${1:TreeNode} cyclus:",
      "    ${2:value} as ${3:int}",
      "    ${4:left} as maybe ref to ${5:TreeNode}",
      "    ${6:right} as maybe ref to ${7:TreeNode}"
    ],
    "description": "`cyclus` recursivo con indirección por puntero"
  },
  "Estructura autorreferencial genérica (cyclus shard)": {
    "prefix": "runecyclusg",
    "body": [
      "rune ${1:Node} cyclus shard ${2:T}:",
      "    ${3:value} as ${4:T}",
      "    ${5:next} as maybe ref to ${6:Node} of ${7:T}",
      "    ${8:children} as list of ${9:Node} of ${10:T}"
    ],
    "description": "`cyclus` genérico (lista enlazada / árbol)"
  },
  "Estructura empaquetada (@packed)": {
    "prefix": "runepacked",
    "body": [
      "@packed",
      "rune ${1:NetHeader}:",
      "    ${2:magic} as u16",
      "    ${3:version} as u8",
      "    ${4:flags} as u8",
      "    ${5:length} as u32"
    ],
    "description": "`rune` sin relleno: solo para fronteras binarias"
  },
  "Estructura alineada (@align)": {
    "prefix": "runealign",
    "body": [
      "@align(${1:32})",
      "rune ${2:AlignedBlock}:",
      "    ${3:data} as array of f32 with size ${4:8}"
    ],
    "description": "`rune` con alineación explícita (SIMD, DMA, ...)"
  },
  "Unión (echo)": {
    "prefix": "echo",
    "body": [
      "echo ${1:Number}:",
      "    ${2:i} as int",
      "    ${3:f} as float"
    ],
    "description": "Unión de C (`echo`); leerla emite el warning W0002"
  },
  "Omen numérico": {
    "prefix": "omen",
    "body": [
      "omen ${1:Direction}:",
      "    ${2:North} is 0",
      "    ${3:South} is 1",
      "    ${4:East} is 2",
      "    ${5:West} is 3"
    ],
    "description": "Enum numérico con valores explícitos"
  },
  "Omen con valor de string": {
    "prefix": "omenstr",
    "body": [
      "omen ${1:Color} with string:",
      "    ${2:Red}",
      "    ${3:Green}",
      "    ${4:Blue}"
    ],
    "description": "Omen cuyas variantes evalúan a su propio nombre (sin payloads)"
  },
  "Omen algebraico (tipo suma)": {
    "prefix": "omenpayload",
    "body": [
      "omen ${1:NetworkEvent}:",
      "    ${2:Disconnected}",
      "    ${3:Connecting} with attempt as int",
      "    ${4:Connected} with session_id as string, latency_ms as float"
    ],
    "description": "Tipo suma con cargas útiles por variante"
  },
  "Concept (contrato)": {
    "prefix": "concept",
    "body": [
      "concept ${1:Formatter}:",
      "    weave ${2:format} with ${3:value} as string into string"
    ],
    "description": "Contrato de compile-time (los miembros no llevan cuerpo ni `:`)"
  },
  "Concept genérico (concept shard)": {
    "prefix": "conceptshard",
    "body": [
      "concept ${1:Container} shard ${2:T}:",
      "    weave ${3:push} with ${4:item} as ${2:T} into void",
      "    weave ${5:len} into int"
    ],
    "description": "Contrato genérico parametrizado con `shard`"
  },
  "Concept con bounds (where)": {
    "prefix": "conceptwhere",
    "body": [
      "concept ${1:Comparable} shard ${2:T} where ${2:T}: ${3:Par}:",
      "    weave ${4:compare} with ${5:other} as ${2:T} into int"
    ],
    "description": "Concept genérico restringido por otro concept"
  },
  "Bind (implementar concept)": {
    "prefix": "bind",
    "body": [
      "bind ${1:Config} with ${2:Formatter}:",
      "    weave ${3:format} with ${4:value} as string into string:",
      "        return \"[{$0}]\""
    ],
    "description": "Implementación de un concept para un tipo"
  },
  "Enchanting (métodos)": {
    "prefix": "enchanting",
    "body": [
      "enchanting ${1:Tipo}:",
      "    weave ${2:display} into string:",
      "        return \"{self->${3:campo}}\"",
      "",
      "    weave ritual ${4:new} with ${5:nombre} as string into ${6:Tipo}:",
      "        return with ${7:campo} is ${5:nombre}"
    ],
    "description": "Bloque `enchanting` con un método de instancia y un `ritual`"
  },
  "Enchanting genérico de contenedor": {
    "prefix": "enchantingshard",
    "body": [
      "enchanting ${1|list of shard T,slice of shard T,map of shard K to shard V,maybe shard T,result of shard T to shard E|}:",
      "    weave ${2:metodo} with ${3:param} as int into ${4:void}:",
      "        $0"
    ],
    "description": "`enchanting` genérico sobre un contenedor estándar (monomorfizado)"
  },
  "Enchanting de primitivos (shard T where)": {
    "prefix": "enchantingprim",
    "body": [
      "enchanting shard ${1:T} where ${1:T}: ${2:Integrum}:",
      "    weave ${3:is_even} into bool:",
      "        return (self % (2 to ${1:T})) == donum ${1:T}"
    ],
    "description": "`enchanting` genérico de primitivos; aquí `self` es un valor"
  },
  "Enchanting concreto (anula el genérico)": {
    "prefix": "enchantingconcrete",
    "body": [
      "enchanting ${1:float}:",
      "    weave ${2:sqrt} into ${1:float}:",
      "        return ${3:0.0}"
    ],
    "description": "Bloque concreto que tiene prioridad sobre el genérico"
  },
  "Alias de tipo": {
    "prefix": "alias",
    "body": [
      "alias ${1:Inches} as ${2:int}"
    ],
    "description": "Alias estructural transparente"
  },
  "Seal (newtype nominal)": {
    "prefix": "seal",
    "body": [
      "seal ${1:UserId} as ${2:int}"
    ],
    "description": "Newtype fuerte: exige conversiones explícitas con `to`"
  },
  "Handle opaco": {
    "prefix": "opaque",
    "body": [
      "alias ${1:Buffer} as opaque"
    ],
    "description": "Handle C incompleto, usado siempre tras `ref to`"
  },
  "Alias de puntero a función": {
    "prefix": "fnalias",
    "body": [
      "alias ${1:Handler} as weave with ${2:x} as int into ${3:void}"
    ],
    "description": "Alias de tipo función (`FnType`)"
  },
  "Binding inmutable tipado (let)": {
    "prefix": "let",
    "body": [
      "let ${1:name} as ${2:string} is ${3:valor}"
    ],
    "description": "Binding local inmutable con tipo explícito"
  },
  "Binding inmutable inferido (let)": {
    "prefix": "letin",
    "body": [
      "let ${1:name} is ${2:valor}"
    ],
    "description": "Binding local inmutable con tipo inferido"
  },
  "Variable mutable tipada (var)": {
    "prefix": "var",
    "body": [
      "var ${1:name} as ${2:int} is ${3:0}"
    ],
    "description": "Variable local mutable con tipo explícito"
  },
  "Variable mutable inferida (var)": {
    "prefix": "varin",
    "body": [
      "var ${1:name} is ${2:valor}"
    ],
    "description": "Variable local mutable con tipo inferido"
  },
  "Binding maybe (some)": {
    "prefix": "letmaybe",
    "body": [
      "var ${1:cfg} as maybe ${2:Config} is some ${3:valor}"
    ],
    "description": "Binding de un `maybe T` presente (el tipo lo infiere el valor)"
  },
  "Desestructuración (let)": {
    "prefix": "destructlet",
    "body": [
      "let (${1:x}, ${2:y}) is ${3:point_value}"
    ],
    "description": "Desestructuración de rune, array, slice o list"
  },
  "Desestructuración tipada (var)": {
    "prefix": "destructvar",
    "body": [
      "var (${1:id}, ${2:label}) as (${3:int}, ${4:string}) is ${5:user_record}"
    ],
    "description": "Desestructuración mutable con tipo por elemento"
  },
  "Desestructuración de tupla": {
    "prefix": "destructtuple",
    "body": [
      "let (${1:cociente}, ${2:ok}) is calling ${3:divide} with ${4:10}, ${5:2}"
    ],
    "description": "Desestructuración de un retorno múltiple (tupla)"
  },
  "Constante de módulo (const)": {
    "prefix": "const",
    "body": [
      "const ${1:MAX_DEPTH} as ${2:int} is ${3:64}"
    ],
    "description": "Constante top-level plegada en compile-time (nunca `let`/`var`)"
  },
  "Variable estática de función (static var)": {
    "prefix": "static",
    "body": [
      "static var ${1:counter} as ${2:int} is ${3:0}"
    ],
    "description": "Estado persistente entre llamadas (patrón de módulo con estado)"
  },
  "Constructor some": {
    "prefix": "some",
    "body": [
      "some ${1:valor}"
    ],
    "description": "Constructor de `maybe T` con valor presente"
  },
  "Ausencia (maybe none)": {
    "prefix": "maybenone",
    "body": [
      "maybe none"
    ],
    "description": "Constructor de `maybe T` vacío"
  },
  "Valor por defecto (donum)": {
    "prefix": "donum",
    "body": [
      "donum ${1:T}"
    ],
    "description": "Valor cero/por defecto de un tipo (compound literal de C)"
  },
  "Asignación (set)": {
    "prefix": "set",
    "body": [
      "set ${1:target} is ${2:valor}"
    ],
    "description": "Reasignación de un objetivo mutable"
  },
  "Asignación de campo en builder (set .)": {
    "prefix": "setdot",
    "body": [
      "set .${1:campo} is ${2:valor}"
    ],
    "description": "Asignación de campo dentro de un bloque `with:`"
  },
  "Asignación por puntero (set self->)": {
    "prefix": "setarrow",
    "body": [
      "set self->${1:campo} is ${2:valor}"
    ],
    "description": "Mutación de un campo de `self` dentro de un método"
  },
  "Asignación por índice (set at)": {
    "prefix": "setat",
    "body": [
      "set ${1:items} at (${2:i} + 1) is ${3:valor}"
    ],
    "description": "Asignación a un contenedor indexado (los paréntesis del índice importan)"
  },
  "Asignación desreferenciada (set essence of)": {
    "prefix": "setessence",
    "body": [
      "set essence of ${1:ptr} is ${2:valor}"
    ],
    "description": "Escritura a través de un puntero (`*ptr = valor`)"
  },
  "Asignación compuesta (+=)": {
    "prefix": "setadd",
    "body": [
      "set ${1:counter} += ${2:1}"
    ],
    "description": "Asignación compuesta numérica (+=); nunca con strings"
  },
  "Asignación compuesta (-=)": {
    "prefix": "setsub",
    "body": [
      "set ${1:total} -= ${2:fee}"
    ],
    "description": "Asignación compuesta numérica (-=)"
  },
  "Asignación compuesta (*=)": {
    "prefix": "setmul",
    "body": [
      "set ${1:acc} *= ${2:factor}"
    ],
    "description": "Asignación compuesta numérica (*=)"
  },
  "Asignación compuesta (/=)": {
    "prefix": "setdiv",
    "body": [
      "set ${1:acc} /= ${2:n}"
    ],
    "description": "Asignación compuesta numérica (/=)"
  },
  "Asignación compuesta (%=)": {
    "prefix": "setmod",
    "body": [
      "set ${1:acc} %= ${2:n}"
    ],
    "description": "Asignación compuesta de módulo (%=), solo enteros"
  },
  "Asignación compuesta (&=)": {
    "prefix": "setband",
    "body": [
      "set ${1:flags} &= ${2:0x0F}"
    ],
    "description": "Asignación compuesta bit a bit (&=)"
  },
  "Asignación compuesta (|=)": {
    "prefix": "setbor",
    "body": [
      "set ${1:flags} |= ${2:0x08}"
    ],
    "description": "Asignación compuesta bit a bit (|=)"
  },
  "Asignación compuesta (^=)": {
    "prefix": "setbxor",
    "body": [
      "set ${1:flags} ^= ${2:0x01}"
    ],
    "description": "Asignación compuesta bit a bit (^=)"
  },
  "Asignación compuesta (<<=)": {
    "prefix": "setshl",
    "body": [
      "set ${1:mask} <<= ${2:2}"
    ],
    "description": "Asignación compuesta de desplazamiento (<<=)"
  },
  "Asignación compuesta (>>=)": {
    "prefix": "setshr",
    "body": [
      "set ${1:mask} >>= ${2:2}"
    ],
    "description": "Asignación compuesta de desplazamiento (>>=)"
  },
  "Condicional if": {
    "prefix": "if",
    "body": [
      "if ${1:cond}:",
      "    $0"
    ],
    "description": "Condicional `if`"
  },
  "Condicional if / else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:cond}:",
      "    ${2:...}",
      "else:",
      "    $0"
    ],
    "description": "Condicional `if` / `else`"
  },
  "If con binding de maybe": {
    "prefix": "ifmaybe",
    "body": [
      "if ${1:v} as ${2:Config} is ${3:maybe_val}:",
      "    $0"
    ],
    "description": "Desempaqueta un `maybe T` con binding tipado (forma Pengunic)"
  },
  "Expresión ternaria (if then else)": {
    "prefix": "ifexpr",
    "body": [
      "if ${1:score >= 100} then ${2:\"alto\"} else ${3:\"bajo\"}"
    ],
    "description": "Expresión `if ... then ... else ...` en una línea"
  },
  "If en posición de valor": {
    "prefix": "ifvalue",
    "body": [
      "let ${1:label} is if ${2:score >= 100}:",
      "    ${3:\"alto\"}",
      "else:",
      "    ${4:\"bajo\"}"
    ],
    "description": "Bloque `if` que produce un valor"
  },
  "Condicional unless": {
    "prefix": "unless",
    "body": [
      "unless ${1:cond}:",
      "    $0"
    ],
    "description": "`unless` equivale a `if not cond`"
  },
  "Condicional unless / else": {
    "prefix": "unlesselse",
    "body": [
      "unless ${1:cond}:",
      "    ${2:...}",
      "else:",
      "    $0"
    ],
    "description": "`unless` con rama `else`"
  },
  "Bucle while": {
    "prefix": "while",
    "body": [
      "while ${1:cond}:",
      "    $0"
    ],
    "description": "Bucle `while`"
  },
  "Bucle for (in)": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:coleccion}:",
      "    $0"
    ],
    "description": "Iteración sobre array, list, slice, string, map o rango"
  },
  "Bucle for-in": {
    "prefix": "forin",
    "body": [
      "for ${1:item} in ${2:coleccion}:",
      "    $0"
    ],
    "description": "Iteración sobre una colección"
  },
  "Bucle for indexado": {
    "prefix": "foridx",
    "body": [
      "for ${1:i}, ${2:item} in ${3:coleccion}:",
      "    $0"
    ],
    "description": "Iteración con índice (o `_` para descartarlo)"
  },
  "Bucle for-from (rango por índices)": {
    "prefix": "forfrom",
    "body": [
      "for ${1:i} from ${2:0} to ${3:10}:",
      "    $0"
    ],
    "description": "Rango numérico semiabierto `[0, 10)`"
  },
  "Bucle for con step": {
    "prefix": "forstep",
    "body": [
      "for ${1:i} from ${2:10} to ${3:0} step ${4:-1}:",
      "    $0"
    ],
    "description": "Rango numérico con paso (admite `step` negativo)"
  },
  "Bucle for sobre un rango": {
    "prefix": "forrange",
    "body": [
      "for ${1:i} in ${2:1} to ${3:5}:",
      "    $0"
    ],
    "description": "Iteración sobre un rango `a to b`"
  },
  "Comprensión de lista": {
    "prefix": "forcomp",
    "body": [
      "for ${1:x} in ${2:nums} then ${3:x * x}"
    ],
    "description": "List comprehension `for ... then ...`"
  },
  "Comprensión con filtro": {
    "prefix": "forcompwhen",
    "body": [
      "for ${1:x} in ${2:nums} when ${3:x % 2 == 0} then ${4:x}"
    ],
    "description": "List comprehension filtrada `for ... when ... then ...`"
  },
  "Pattern matching (judge)": {
    "prefix": "judge",
    "body": [
      "judge ${1:estado}:",
      "    when ${2:Phase.Idle} -> ${3:\"idle\"}",
      "    when ${4:Phase.Fighting} -> ${5:\"fighting\"}",
      "    else -> ${6:\"?\"}"
    ],
